# Copy to .env and replace every replace_me value before first boot.
#   cp .env.example .env
#   openssl rand -hex 32
#
# Production host .env lives on the droplet only. Do not commit it.

# --- Public edge ---
PUBLIC_HOST=pm.newmarketsecurity.com
PUBLIC_URL=https://pm.newmarketsecurity.com
# Do not start a second Caddy and do not bind 80/443 from this compose file.
EDGE_NETWORK=proxy
LISTEN_HTTP_PORT=8088

# --- Windshift (official image) ---
WINDSHIFT_VERSION=v0.8.8
WINDSHIFT_MEMORY_LIMIT_MB=512
WINDSHIFT_CONTAINER_MEMORY_LIMIT=768m
SESSION_IP_BINDING=log
ENABLE_ADMIN_FALLBACK=true
WEBAUTHN_RP_NAME=New Market Security
LOG_LEVEL=info
LOG_FORMAT=json

# Generate once and keep stable: openssl rand -hex 32
SSO_SECRET=replace_me

# --- Postgres (not published to the host network) ---
POSTGRES_USER=windshift
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=windshift

# --- SSO (Keycloak realm nms, PKCE) ---
# Admin > Single Sign-On uses issuer like:
#   https://auth.newmarketsecurity.com/realms/nms
OIDC_ISSUER=https://auth.newmarketsecurity.com/realms/nms
OIDC_CLIENT_ID=pm
OIDC_CLIENT_SECRET=replace_me
OIDC_SLUG=nms
OIDC_SCOPES=openid email profile

# First-run instance admin (local recovery account). After SSO works,
# sign in with Keycloak and set Admin > Authentication to SSO required.
SETUP_ADMIN_EMAIL=replace_me
SETUP_ADMIN_USERNAME=admin
SETUP_ADMIN_PASSWORD=replace_me
SETUP_ADMIN_FIRST_NAME=Nic
SETUP_ADMIN_LAST_NAME=Southern
