# Copy to .env and replace every replace_me value before first boot.
#   cp .env.example .env
#   openssl rand -hex 24   # use a fresh value per secret
#
# Production host .env lives on the droplet only. Do not commit it.

# --- Public edge ---
PUBLIC_HOST=pm.newmarketsecurity.com
PUBLIC_URL=https://pm.newmarketsecurity.com
# Do not start a second Caddy and do not bind 80/443 from this compose file.
EDGE_NETWORK=proxy
LISTEN_HTTP_PORT=8088

# --- Plane (official Community images) ---
APP_RELEASE=v1.4.2
APP_DOMAIN=pm.newmarketsecurity.com
WEB_URL=https://pm.newmarketsecurity.com
CORS_ALLOWED_ORIGINS=https://pm.newmarketsecurity.com
API_BASE_URL=http://api:8000
DEBUG=0
SITE_ADDRESS=:80
TRUSTED_PROXIES=0.0.0.0/0
GUNICORN_WORKERS=1

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace_me
LIVE_SERVER_SECRET_KEY=replace_me

# --- Postgres (not published to the host network) ---
POSTGRES_USER=plane
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=plane
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:replace_me@plane-db:5432/plane

# --- Redis ---
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# --- RabbitMQ ---
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=replace_me
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:replace_me@plane-mq:5672/plane

# --- Object storage (in-cluster MinIO) ---
USE_MINIO=1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
MINIO_ENDPOINT_SSL=0

# --- SSO (Keycloak realm nms) ---
OIDC_ISSUER=https://auth.newmarketsecurity.com/realms/nms
OIDC_CLIENT_ID=plane
OIDC_CLIENT_SECRET=replace_me
OIDC_SCOPES=openid email profile
# oauth2-proxy cookie secret must be 16, 24, or 32 raw bytes (openssl rand -hex 16)
OAUTH2_PROXY_COOKIE_SECRET=replace_me
OAUTH2_PROXY_EMAIL_DOMAINS=newmarketsecurity.com
